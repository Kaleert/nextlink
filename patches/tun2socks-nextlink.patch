index 0000000..cb868a5
--- /dev/null
+++ b/tunnel/policy_test.go
@@ -0,0 +1,45 @@
+package tunnel
+
+import (
+	"github.com/xjasonlyu/tun2socks/v2/tunnel/statistic"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+	"net"
+	"testing"
+)
+
+type blockedTCP struct {
+	net.Conn
+	closed bool
+}
+
+func (c *blockedTCP) ID() stack.TransportEndpointID {
+	return stack.TransportEndpointID{RemotePort: 12345, LocalPort: 443}
+}
+func (c *blockedTCP) Close() error { c.closed = true; return c.Conn.Close() }
+
+type blockedUDP struct{ *blockedTCP }
+
+func (c *blockedUDP) ReadFrom(b []byte) (int, net.Addr, error)  { n, e := c.Read(b); return n, nil, e }
+func (c *blockedUDP) WriteTo(b []byte, _ net.Addr) (int, error) { return c.Write(b) }
+func TestBlockedTCPAndUDPDoNotDialProxy(t *testing.T) {
+	statistic.SetOwnerLookup(func(int, string, int, string, int) int { return 10042 })
+	statistic.SetAppPolicy(`{"blocked":[10042]}`)
+	defer statistic.SetOwnerLookup(nil)
+	defer statistic.SetAppPolicy("")
+	// nil proxy would panic if either handler tried to dial upstream.
+	tunnel := New(nil, statistic.DefaultManager)
+	left, right := net.Pipe()
+	tcp := &blockedTCP{Conn: left}
+	defer right.Close()
+	tunnel.handleTCPConn(tcp)
+	if !tcp.closed {
+		t.Fatal("TCP left open")
+	}
+	left, right = net.Pipe()
+	udp := &blockedUDP{&blockedTCP{Conn: left}}
+	defer right.Close()
+	tunnel.handleUDPConn(udp)
+	if !udp.closed {
+		t.Fatal("UDP left open")
+	}
+}
diff --git a/tunnel/statistic/accounting.go b/tunnel/statistic/accounting.go
new file mode 100644
index 0000000..005fe4a
--- /dev/null
+++ b/tunnel/statistic/accounting.go
@@ -0,0 +1,81 @@
+package statistic
+
+import (
+	"encoding/json"
+	M "github.com/xjasonlyu/tun2socks/v2/metadata"
+	"sync"
+	"sync/atomic"
+)
+
+type OwnerLookup func(protocol int, source string, sourcePort int, destination string, destinationPort int) int
+
+var ownerMu sync.RWMutex
+var ownerLookup OwnerLookup
+var currentCounters atomic.Pointer[trafficCounters]
+
+type trafficCounters struct {
+	mu       sync.Mutex
+	upload   int64
+	download int64
+	apps     map[int]int64
+}
+type account struct {
+	owner    int
+	counters *trafficCounters
+}
+
+func SetOwnerLookup(lookup OwnerLookup) { ownerMu.Lock(); ownerLookup = lookup; ownerMu.Unlock() }
+func ResetTraffic()                     { currentCounters.Store(&trafficCounters{apps: make(map[int]int64)}) }
+
+// ResolveOwner is shared by firewall and accounting: one Android tuple lookup.
+func ResolveOwner(metadata *M.Metadata) int {
+	if metadata.OwnerResolved {
+		return metadata.OwnerUID
+	}
+	ownerMu.RLock()
+	lookup := ownerLookup
+	ownerMu.RUnlock()
+	uid := -1
+	if lookup != nil {
+		protocol := 6
+		if metadata.Network == M.UDP {
+			protocol = 17
+		}
+		uid = lookup(protocol, metadata.SrcIP.String(), int(metadata.SrcPort), metadata.DstIP.String(), int(metadata.DstPort))
+	}
+	metadata.OwnerUID, metadata.OwnerResolved = uid, true
+	return uid
+}
+func newAccount(metadata *M.Metadata) *account {
+	counters := currentCounters.Load()
+	if counters == nil {
+		return nil
+	}
+	uid := ResolveOwner(metadata)
+	return &account{owner: uid, counters: counters}
+}
+func (a *account) add(upload, download int64) {
+	if a == nil || upload+download <= 0 {
+		return
+	}
+	c := a.counters
+	c.mu.Lock()
+	c.upload += upload
+	c.download += download
+	c.apps[a.owner] += upload + download
+	c.mu.Unlock()
+}
+func TrafficSnapshot() string {
+	c := currentCounters.Load()
+	if c == nil {
+		return `{"upload":0,"download":0,"apps":{}}`
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	data, _ := json.Marshal(struct {
+		Upload   int64         `json:"upload"`
+		Download int64         `json:"download"`
+		Apps     map[int]int64 `json:"apps"`
+	}{c.upload, c.download, c.apps})
+	return string(data)
+}
