@@ -0,0 +1,41 @@
+package statistic
+
+import (
+	M "github.com/xjasonlyu/tun2socks/v2/metadata"
+	"testing"
+)
+
+func TestAppPolicySharesOwnerWithAccountingAndRejectsUnknown(t *testing.T) {
+	defer SetAppPolicy("")
+	defer SetOwnerLookup(nil)
+	calls := 0
+	SetOwnerLookup(func(int, string, int, string, int) int { calls++; return 10042 })
+	if err := SetAppPolicy(`{"blocked":[10042],"blockUnknown":true}`); err != nil {
+		t.Fatal(err)
+	}
+	metadata := &M.Metadata{}
+	if AllowConnection(metadata) {
+		t.Fatal("blocked UID allowed")
+	}
+	ResetTraffic()
+	a := newAccount(metadata)
+	if a.owner != 10042 || calls != 1 {
+		t.Fatalf("owner not reused: %d calls %d", a.owner, calls)
+	}
+	SetOwnerLookup(nil)
+	if AllowConnection(&M.Metadata{Network: M.UDP}) {
+		t.Fatal("unknown owner leaked")
+	}
+	if err := SetAppPolicy(`{"defaultBlock":true,"allowed":[10050],"blockUnknown":true}`); err != nil {
+		t.Fatal(err)
+	}
+	for uid, want := range map[int]bool{10050: true, 10042: false, -1: false} {
+		if got := AllowConnection(&M.Metadata{OwnerResolved: true, OwnerUID: uid}); got != want {
+			t.Fatalf("UID %d got %v", uid, got)
+		}
+	}
+	SetAppPolicy("")
+	if !AllowConnection(&M.Metadata{}) {
+		t.Fatal("disabled policy blocks")
+	}
+}
