@@ -0,0 +1,63 @@
+package statistic
+
+import (
+	"encoding/json"
+	M "github.com/xjasonlyu/tun2socks/v2/metadata"
+	"io"
+	"net"
+	"net/netip"
+	"testing"
+)
+
+func snapshot(t *testing.T) (int64, int64, map[string]int64) {
+	t.Helper()
+	var v struct {
+		Upload   int64            `json:"upload"`
+		Download int64            `json:"download"`
+		Apps     map[string]int64 `json:"apps"`
+	}
+	if err := json.Unmarshal([]byte(TrafficSnapshot()), &v); err != nil {
+		t.Fatal(err)
+	}
+	return v.Upload, v.Download, v.Apps
+}
+func TestClosedConnectionTrafficRemainsAndResetIsolatesOldConnections(t *testing.T) {
+	ResetTraffic()
+	SetOwnerLookup(func(protocol int, source string, sp int, destination string, dp int) int {
+		if protocol != 6 || sp != 2345 || dp != 443 {
+			t.Fatalf("wrong tuple: %d %s:%d %s:%d", protocol, source, sp, destination, dp)
+		}
+		return 10042
+	})
+	defer SetOwnerLookup(nil)
+	left, right := net.Pipe()
+	tracker := NewTCPTracker(left, &M.Metadata{Network: M.TCP, SrcIP: netip.MustParseAddr("172.19.0.1"), DstIP: netip.MustParseAddr("1.1.1.1"), SrcPort: 2345, DstPort: 443}, DefaultManager)
+	done := make(chan struct{})
+	go func() { defer close(done); right.Write([]byte("response")); io.ReadFull(right, make([]byte, 7)) }()
+	io.ReadFull(tracker, make([]byte, 8))
+	tracker.Write([]byte("request"))
+	<-done
+	tracker.Close()
+	right.Close()
+	up, down, apps := snapshot(t)
+	if up != 7 || down != 8 || apps["10042"] != 15 {
+		t.Fatalf("wrong counters %d %d %v", up, down, apps)
+	}
+	old := newAccount(&M.Metadata{Network: M.TCP, SrcPort: 2345, DstPort: 443})
+	ResetTraffic()
+	old.add(100, 200)
+	up, down, apps = snapshot(t)
+	if up != 0 || down != 0 || len(apps) != 0 {
+		t.Fatalf("old session leaked into reset: %d %d %v", up, down, apps)
+	}
+}
+func TestUnknownOwnerStillCountsVpnPayload(t *testing.T) {
+	ResetTraffic()
+	SetOwnerLookup(nil)
+	account := newAccount(&M.Metadata{Network: M.UDP})
+	account.add(20, 30)
+	up, down, apps := snapshot(t)
+	if up != 20 || down != 30 || apps["-1"] != 50 {
+		t.Fatalf("lost unknown-owner traffic: %d %d %v", up, down, apps)
+	}
+}
diff --git a/tunnel/statistic/policy.go b/tunnel/statistic/policy.go
new file mode 100644
index 0000000..83284c2
--- /dev/null
+++ b/tunnel/statistic/policy.go
@@ -0,0 +1,61 @@
+package statistic
+
+import (
+	"encoding/json"
+	"fmt"
+	M "github.com/xjasonlyu/tun2socks/v2/metadata"
+	"sync/atomic"
+)
+
+type policyConfig struct {
+	Blocked      []int `json:"blocked"`
+	Allowed      []int `json:"allowed"`
+	DefaultBlock bool  `json:"defaultBlock"`
+	BlockUnknown bool  `json:"blockUnknown"`
+}
+type appPolicy struct {
+	blocked, allowed           map[int]bool
+	defaultBlock, blockUnknown bool
+}
+
+var activePolicy atomic.Pointer[appPolicy]
+
+func SetAppPolicy(config string) error {
+	if config == "" {
+		activePolicy.Store(nil)
+		return nil
+	}
+	var cfg policyConfig
+	if err := json.Unmarshal([]byte(config), &cfg); err != nil {
+		return err
+	}
+	p := &appPolicy{blocked: map[int]bool{}, allowed: map[int]bool{}, defaultBlock: cfg.DefaultBlock, blockUnknown: cfg.BlockUnknown}
+	for _, uid := range cfg.Blocked {
+		if uid < 0 {
+			return fmt.Errorf("invalid blocked UID")
+		}
+		p.blocked[uid] = true
+	}
+	for _, uid := range cfg.Allowed {
+		if uid < 0 {
+			return fmt.Errorf("invalid allowed UID")
+		}
+		p.allowed[uid] = true
+	}
+	activePolicy.Store(p)
+	return nil
+}
+func AllowConnection(metadata *M.Metadata) bool {
+	uid := ResolveOwner(metadata)
+	p := activePolicy.Load()
+	if p == nil {
+		return true
+	}
+	if uid < 0 {
+		return !p.blockUnknown
+	}
+	if p.blocked[uid] {
+		return false
+	}
+	return !p.defaultBlock || p.allowed[uid]
+}
